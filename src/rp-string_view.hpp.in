#pragma once

#ifdef __cplusplus

/* Define to 1 if std::string_view is available. */
#cmakedefine HAVE_STD_STRING_VIEW 1

/* Define to 1 if std::experimental::string_view is available. */
#cmakedefine HAVE_STD_EXPERIMENTAL_STRING_VIEW 1

/* Define to 1 if std::ostringstream has a view() function. */
#cmakedefine HAVE_STD_OSTRINGSTREAM_VIEW 1

#if defined(HAVE_STD_STRING_VIEW)
#  include <string_view>
#  define STRING_ASSIGN_SV(str, sv)    (str).assign(sv)
#  define WSTRING_ASSIGN_WSV(wcs, wsv) (wcs).assign(wsv)
#elif defined(HAVE_STD_EXPERIMENTAL_STRING_VIEW)
// Pull std::experimental::string_view into the std nemspace.
#  include <experimental/string_view>
namespace std {
	using std::experimental::basic_string_view;
	using std::experimental::string_view;
	using std::experimental::wstring_view;
}
#  define STRING_ASSIGN_SV(str, sv)    (str) =  std::string(sv)
#  define WSTRING_ASSIGN_WSV(wcs, wsv) (wcs) = std::wstring(wsv)
#endif

#endif /* __cplusplus */

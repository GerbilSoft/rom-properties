#pragma once

#ifdef __cplusplus

#cmakedefine HAVE_STD_STRING_VIEW 1
#cmakedefine HAVE_STD_EXPERIMENTAL_STRING_VIEW 1

#if defined(HAVE_STD_STRING_VIEW)
#  include <string_view>
#  define STRING_VIEW_ASSIGN(sv, str)   (sv).assign(str)
#  define WSTRING_VIEW_ASSIGN(wsv, wcs) (wsv).assign(wcs)
#elif defined(HAVE_STD_EXPERIMENTAL_STRING_VIEW)
// Pull std::experimental::string_view into the std nemspace.
#  include <experimental/string_view>
namespace std {
	using string_view = std::experimental::string_view;
	using wstring_view = std::experimental::wstring_view;
}
#  define STRING_VIEW_ASSIGN(sv, str)    (sv) =  std::string(str)
#  define WSTRING_VIEW_ASSIGN(wsv, wcs) (wsv) = std::wstring(str)
#endif

#endif /* __cplusplus */

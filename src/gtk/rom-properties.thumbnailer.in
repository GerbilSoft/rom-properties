[Thumbnailer Entry]
# Thumbnailer entry for Nautilus (GNOME 3) and Caja (MATE 1.18+).
# Reference: https://developer.gnome.org/gnome-desktop3/stable/GnomeDesktopThumbnailFactory.html
TryExec=@CMAKE_INSTALL_FULL_LIBEXECDIR@/rp-thumbnail
Exec=@CMAKE_INSTALL_FULL_LIBEXECDIR@/rp-thumbnail -s %s %u %o

# Supported MIME types.
# For GNOME thumbnailers, only thumbnailable types are listed.
# NOTE: The first MIME type listed is a hack to indicate on KDE that this
# .thumbnailer preview plugin shouldn't be used. Use the KDE-specific
# thumbnailing plugin on KDE instead.
X-NotShowIn=KDE;
MimeType=application/x-dummy-rom-properties-thumbnailer-kde;@MIMETYPES_THUMBONLY@

[Desktop Entry]
Encoding=UTF-8
Type=Service
Name=ROM Properties Page (directory thumbnailer)
ServiceTypes=ThumbCreator

# KDE service settings.
X-KDE-Library=rom-properties-kde4
X-KDE-ServiceTypes=ThumbCreator
X-KDE-Protocol=file
X-KDE-Protocols=file,desktop

# Supported MIME types.
# For KDE ThumbCreator, only thumbnailable types are listed.
MimeType=inode/directory;

# ThumbCreator settings.
CacheThumbnail=true
IgnoreMaximumSize=true
